@{
    Layout = "_Layout";
    ViewData["Title"] = "Purchasing & Inbound";
}

<!-- Purchasing & Inbound Header -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-cart-flatbed me-2 text-primary"></i>Purchasing & Inbound</h2>
                <p class="text-muted mb-0">Manage supplier purchase orders, stock intake vouchers, payments, and supplier directory.</p>
            </div>
        </div>
    </div>
</div>

<!-- Purchasing & Inbound Tabs -->
<ul class="nav nav-tabs nav-fill mb-4 bg-white p-2 rounded shadow-sm" id="purchasingTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="purchases-tab" data-bs-toggle="tab" data-bs-target="#purchases" type="button" role="tab" aria-controls="purchases">
            <i class="fas fa-file-invoice-dollar me-2"></i> Purchases Voucher
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="suppliers-tab" data-bs-toggle="tab" data-bs-target="#suppliers" type="button" role="tab" aria-controls="suppliers">
            <i class="fas fa-truck-field me-2"></i> Suppliers Directory
        </button>
    </li>
</ul>

<!-- Purchasing & Inbound Tab Content -->
<div class="tab-content" id="purchasingTabsContent">
    <partial name="Partials/_PurchasesTab" />
    <partial name="Partials/_SuppliersTab" />
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/purchases.js" asp-append-version="true"></script>
    <script src="~/js/suppliers.js" asp-append-version="true"></script>
}
