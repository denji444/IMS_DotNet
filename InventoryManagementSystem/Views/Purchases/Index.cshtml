@model InventoryManagementSystem.Models.Purchase
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Purchases";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
        <h4 class="mb-0"><i class="fas fa-file-import me-2"></i>Stock In / Purchases</h4>
        <button class="btn btn-light btn-sm" onclick="openCreateModal()">
            <i class="fas fa-plus me-1"></i> New Purchase
        </button>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle w-100" id="purchasesTable">
                <thead class="table-dark text-center">
                    <tr>
                        <th class="text-center">Voucher & Date</th>
                        <th class="text-center">Product & Batch</th>
                        <th class="text-center">Supplier</th>
                        <th class="text-center">Qty</th>
                        <th class="text-center">Cost Details</th>
                        <th class="text-center">Notes</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Loaded dynamically via DataTables AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Purchase Create/Edit Modal -->
<div class="modal fade" id="purchaseModal" role="dialog" aria-labelledby="purchaseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="purchaseModalLabel">New Purchase</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="purchaseForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="purchaseId" name="Id" value="0" />
                
                <div class="modal-body p-4">
                    <div class="mb-3" id="supplierSelectContainer">
                        <label asp-for="SupplierId" class="form-label text-secondary small fw-bold mb-1"></label>
                        <select asp-for="SupplierId" class="form-select select2-supplier w-100" id="supplierSelect" required>
                            <!-- Remotely bound -->
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>
                    </div>

                    <div class="form-check form-switch mb-3" id="newSupplierToggleContainer">
                        <input class="form-check-input" type="checkbox" id="newSupplierToggle">
                        <label class="form-check-label text-secondary small fw-bold" for="newSupplierToggle">New Supplier?</label>
                    </div>

                    <div id="newSupplierFields" class="d-none border rounded p-3 mb-3 bg-light">
                        <h6 class="text-dark mb-3 fw-bold"><i class="fas fa-truck-field me-2"></i>New Supplier Details</h6>
                        <div class="form-floating mb-3">
                            <input class="form-control" id="newSupplierName" placeholder="Supplier Name" />
                            <label for="newSupplierName">Supplier Name</label>
                            <span class="text-danger small" id="newSupplierNameError"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" type="email" id="newSupplierEmail" placeholder="Email" />
                                    <label for="newSupplierEmail">Email Address</label>
                                    <span class="text-danger small" id="newSupplierEmailError"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" id="newSupplierPhone" placeholder="Phone" />
                                    <label for="newSupplierPhone">Phone Number</label>
                                    <span class="text-danger small" id="newSupplierPhoneError"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-floating mb-3">
                            <input class="form-control cnic-input" id="newSupplierCnic" placeholder="CNIC (e.g. 35201-1234567-1)" maxlength="15" />
                            <label for="newSupplierCnic">CNIC No (Optional)</label>
                            <span class="text-danger small" id="newSupplierCnicError"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <textarea class="form-control" id="newSupplierAddress" placeholder="Address" style="height: 70px;"></textarea>
                            <label for="newSupplierAddress">Address</label>
                            <span class="text-danger small" id="newSupplierAddressError"></span>
                        </div>
                    </div>

                    <!-- Multi-Item Purchase Voucher Builder -->
                    <div class="border rounded p-3 mb-3 bg-light">
                        <h6 class="text-dark mb-3 fw-bold"><i class="fas fa-boxes text-primary me-2"></i>Voucher Items Selection</h6>
                        
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label text-secondary small fw-bold mb-1">Filter Category</label>
                                <select class="form-select form-select-sm" id="itemCategoryFilter">
                                    <option value="">-- All Categories --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-secondary small fw-bold mb-1">Filter Product Type</label>
                                <select class="form-select form-select-sm" id="itemTypeFilter">
                                    <option value="">-- All Product Types --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-7">
                                <label class="form-label text-secondary small fw-bold mb-1">Select Product SKU</label>
                                <select class="form-select select2-product w-100" id="productSelect">
                                    <!-- Remotely bound -->
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label text-secondary small fw-bold mb-1">Batch Name / Lot (Optional)</label>
                                <input class="form-control form-control-sm" id="batchNumber" placeholder="e.g. May 2026 Batch" />
                            </div>
                        </div>

                        <div class="row g-2 mb-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label text-secondary small fw-bold mb-1">Quantity</label>
                                <input class="form-control form-control-sm" type="number" id="purchaseQty" min="1" value="1" placeholder="Qty" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label text-secondary small fw-bold mb-1">Unit Cost (PKR)</label>
                                <input class="form-control form-control-sm" type="number" step="0.01" id="unitPrice" placeholder="Unit Price" />
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-primary btn-sm w-100" id="btnAddPurchaseItem">
                                    <i class="fas fa-plus me-1"></i> Add Item
                                </button>
                            </div>
                        </div>

                        <!-- Draft Items Table -->
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered bg-white align-middle text-center mb-0" id="purchaseItemsTable">
                                <thead class="table-dark small">
                                    <tr>
                                        <th style="width: 35%;">Product</th>
                                        <th style="width: 20%;">Batch</th>
                                        <th style="width: 12%;">Qty</th>
                                        <th style="width: 15%;">Unit Cost</th>
                                        <th style="width: 15%;">Total</th>
                                        <th style="width: 3%;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="purchaseItemsTableBody">
                                    <tr id="emptyPurchaseItemsRow">
                                        <td colspan="6" class="text-muted small py-3">No items added to voucher yet. Select a product and click "Add Item".</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="TotalCost" class="form-control bg-light fw-bold text-dark fs-5" type="number" id="totalCost" placeholder="Total Cost" readonly />
                        <label asp-for="TotalCost" class="fw-bold">Grand Total Cost (PKR)</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold mb-1">Payment Mode</label>
                        <select asp-for="PaymentMode" class="form-select" id="paymentMode" required>
                            <option value="0">Full Payment</option>
                            <option value="1">Lease / Installments</option>
                        </select>
                        <span asp-validation-for="PaymentMode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold mb-1"><i class="fas fa-credit-card me-1 text-primary"></i>Payment Method</label>
                        <select asp-for="PaymentMethod" class="form-select" id="paymentMethod" required>
                            <option value="0">Cash</option>
                            <option value="1">Check</option>
                            <option value="2">Online Transfer</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    </div>

                    <!-- Dynamic Payment Method Details -->
                    <div id="paymentMethodDetailsContainer" class="border rounded p-3 mb-3 bg-light">
                        <!-- Cash Options -->
                        <div id="cashFields" class="payment-method-fields">
                            <h6 class="text-dark mb-2 fw-bold"><i class="fas fa-money-bill-wave text-success me-2"></i>Cash Details</h6>
                            <div class="form-floating">
                                <input class="form-control" id="cashReference" placeholder="Receipt / Ref #" />
                                <label for="cashReference">Receipt / Ref # (Optional)</label>
                            </div>
                        </div>
                        <!-- Check Options -->
                        <div id="checkFields" class="payment-method-fields d-none">
                            <h6 class="text-dark mb-2 fw-bold"><i class="fas fa-money-check text-warning me-2"></i>Check Details</h6>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" id="checkBankName" placeholder="Bank Name" />
                                        <label for="checkBankName">Bank Name</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" id="checkNumber" placeholder="Check Number" />
                                        <label for="checkNumber">Check Number</label>
                                    </div>
                                </div>
                                <div class="col-md-12 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" type="date" id="checkDate" placeholder="Check Date" />
                                        <label for="checkDate">Check Date</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Online Transfer Options -->
                        <div id="onlineTransferFields" class="payment-method-fields d-none">
                            <h6 class="text-dark mb-2 fw-bold"><i class="fas fa-university text-info me-2"></i>Online Transfer Details</h6>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" id="transferBankName" placeholder="Bank / Platform Name" />
                                        <label for="transferBankName">Bank / Platform (e.g. Meezan, JazzCash)</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" id="transferTxnId" placeholder="Transaction / Ref ID" />
                                        <label for="transferTxnId">Transaction / Ref ID</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="leaseFields" class="d-none border rounded p-3 mb-3 bg-light">
                        <h6 class="text-dark mb-3 fw-bold"><i class="fas fa-calendar-alt me-2"></i>Lease Configuration</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DownPayment" class="form-label text-secondary small fw-bold mb-1"></label>
                                <input asp-for="DownPayment" class="form-control" type="number" id="downPayment" placeholder="Down Payment" min="0" step="0.01" value="0.00" />
                                <span asp-validation-for="DownPayment" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="InstallmentFrequency" class="form-label text-secondary small fw-bold mb-1"></label>
                                <select asp-for="InstallmentFrequency" class="form-select" id="installmentFrequency">
                                    <option value="Monthly">Monthly</option>
                                    <option value="Weekly">Weekly</option>
                                </select>
                                <span asp-validation-for="InstallmentFrequency" class="text-danger"></span>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label asp-for="InstallmentsCount" class="form-label text-secondary small fw-bold mb-1">Installments Count</label>
                                <input asp-for="InstallmentsCount" class="form-control" type="number" id="installmentsCount" placeholder="Number of Installments" min="1" value="3" />
                                <span asp-validation-for="InstallmentsCount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="text-dark small fw-bold" id="leaseEstimate"></div>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Notes" class="form-control" id="notes" placeholder="Notes" style="height: 80px;"></textarea>
                        <label asp-for="Notes"></label>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark" id="btnSavePurchase">Save Purchase</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Lease Installment Modal -->
<div class="modal fade" id="leaseScheduleModal" tabindex="-1" role="dialog" aria-labelledby="leaseScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="leaseScheduleModalLabel"><i class="fas fa-calendar-alt me-2"></i>Lease Installment Schedule</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-3 bg-light p-3 rounded border mx-0">
                    <div class="col-md-6 mb-2">
                        <span class="text-secondary small fw-bold">Purchase Number:</span>
                        <div id="leasePurchaseNo" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <span class="text-secondary small fw-bold">Total Cost:</span>
                        <div id="leaseTotalCost" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-secondary small fw-bold">Down Payment:</span>
                        <div id="leaseDownPayment" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-secondary small fw-bold">Remaining Balance:</span>
                        <div id="leaseRemainingBalance" class="fw-bold text-dark">-</div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100 align-middle" id="leaseScheduleTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Installment #</th>
                                <th>Due Date</th>
                                <th>Amount</th>
                                <th>Paid</th>
                                <th>Payment Date</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="leaseScheduleBody">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/purchases.js" asp-append-version="true"></script>
}
