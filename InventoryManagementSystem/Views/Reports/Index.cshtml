@model IEnumerable<InventoryManagementSystem.Models.ViewModels.ProductReportViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Financials, Reports & Accounting";
}

<div class="row mb-4">
    <div class="col-12 border-bottom pb-3 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-file-invoice-dollar me-2 text-primary"></i>Financials, Reports & Accounting</h2>
            <p class="text-muted mb-0">Product performance directory, Profit & Loss financial statement, and installment aging tracker.</p>
        </div>
    </div>
</div>

<!-- Navigation Tabs -->
<ul class="nav nav-pills nav-fill bg-white p-2 rounded shadow-sm mb-4" id="reportsTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold py-2" id="product-tab" data-bs-toggle="tab" data-bs-target="#product-pane" type="button" role="tab">
            <i class="fas fa-boxes me-2"></i>Product Performance
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2" id="pnl-tab" data-bs-toggle="tab" data-bs-target="#pnl-pane" type="button" role="tab">
            <i class="fas fa-calculator me-2"></i>Profit & Loss Statement
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2" id="aging-tab" data-bs-toggle="tab" data-bs-target="#aging-pane" type="button" role="tab">
            <i class="fas fa-hourglass-half me-2"></i>Installment Aging Tracker
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2" id="customer-tab" data-bs-toggle="tab" data-bs-target="#customer-pane" type="button" role="tab">
            <i class="fas fa-user-tag me-2"></i>Customer Statement Report
        </button>
    </li>
</ul>

<div class="tab-content" id="reportsTabContent">
    <!-- TAB 1: Product Performance Directory -->
    <div class="tab-pane fade show active" id="product-pane" role="tabpanel">
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100 border-start border-primary border-4 py-2">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1 small fw-bold">Total Products</div>
                                <div class="h5 mb-0 fw-bold text-gray-800" id="totalProducts">0</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-boxes fa-2x text-gray-300 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100 border-start border-info border-4 py-2">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1 small fw-bold">Available Stock</div>
                                <div class="h5 mb-0 fw-bold text-gray-800" id="totalAvailableQty">0</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-cubes fa-2x text-gray-300 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100 border-start border-warning border-4 py-2">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1 small fw-bold">Total Purchased Value</div>
                                <div class="h5 mb-0 fw-bold text-gray-800" id="totalPurchasedCost">PKR 0.00</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-shopping-cart fa-2x text-gray-300 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card border-0 shadow-sm h-100 border-start border-success border-4 py-2">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1 small fw-bold">Total Sales Revenue</div>
                                <div class="h5 mb-0 fw-bold text-gray-800" id="totalSalesRevenue">PKR 0.00</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-dollar-sign fa-2x text-gray-300 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Product Performance Directory</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100" id="reportsTable">
                        <thead class="table-dark">
                            <tr>
                                <th>SKU</th>
                                <th>Product Name</th>
                                <th>Variant</th>
                                <th>Available Stock</th>
                                <th>Purchased Qty</th>
                                <th>Sold Qty</th>
                                <th>Total Purchase Cost</th>
                                <th>Total Sales Revenue</th>
                                <th>Estimated Profit</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 2: Profit & Loss Statement -->
    <div class="tab-pane fade" id="pnl-pane" role="tabpanel">
        <!-- Date Filters -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3 bg-light rounded d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold text-dark"><i class="fas fa-filter me-1"></i>Date Presets:</span>
                    <button class="btn btn-outline-dark btn-sm pnl-preset" data-preset="this-month">This Month</button>
                    <button class="btn btn-outline-dark btn-sm pnl-preset" data-preset="last-month">Last Month</button>
                    <button class="btn btn-outline-dark btn-sm pnl-preset" data-preset="ytd">Year To Date</button>
                    <button class="btn btn-outline-dark btn-sm pnl-preset active" data-preset="all">All Time</button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input type="date" id="pnlStartDate" class="form-control form-control-sm" />
                    <span>to</span>
                    <input type="date" id="pnlEndDate" class="form-control form-control-sm" />
                    <button id="btnFilterPnl" class="btn btn-primary btn-sm"><i class="fas fa-search me-1"></i>Filter</button>
                </div>
            </div>
        </div>

        <!-- P&L Financial Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-xl-2">
                <div class="card shadow-sm border-0 border-start border-success border-4 rounded p-3 h-100">
                    <small class="text-uppercase text-muted fw-bold">Gross Revenue</small>
                    <h5 class="fw-bold text-success mb-0 mt-1" id="pnlGrossRevenue">PKR 0.00</h5>
                    <small class="text-muted">Total Sales</small>
                </div>
            </div>
            <div class="col-md-4 col-xl-2">
                <div class="card shadow-sm border-0 border-start border-danger border-4 rounded p-3 h-100">
                    <small class="text-uppercase text-muted fw-bold">Cost of Goods (COGS)</small>
                    <h5 class="fw-bold text-danger mb-0 mt-1" id="pnlCogs">PKR 0.00</h5>
                    <small class="text-muted">Stock Outlay</small>
                </div>
            </div>
            <div class="col-md-4 col-xl-2">
                <div class="card shadow-sm border-0 border-start border-primary border-4 rounded p-3 h-100">
                    <small class="text-uppercase text-muted fw-bold">Gross Profit</small>
                    <h5 class="fw-bold text-primary mb-0 mt-1" id="pnlGrossProfit">PKR 0.00</h5>
                    <small class="text-muted">Revenue - COGS</small>
                </div>
            </div>
            <div class="col-md-4 col-xl-3">
                <div class="card shadow-sm border-0 border-start border-warning border-4 rounded p-3 h-100">
                    <small class="text-uppercase text-muted fw-bold">Payroll Expenses</small>
                    <h5 class="fw-bold text-warning mb-0 mt-1" id="pnlPayroll">PKR 0.00</h5>
                    <small class="text-muted">Active Employee Overhead</small>
                </div>
            </div>
            <div class="col-md-4 col-xl-3">
                <div class="card shadow-sm border-0 border-start border-dark border-4 rounded p-3 h-100 bg-dark text-white">
                    <small class="text-uppercase text-light fw-bold">Net Operating Income</small>
                    <h4 class="fw-bold text-white mb-0 mt-1" id="pnlNetIncome">PKR 0.00</h4>
                    <small class="text-muted">Gross Profit - Payroll</small>
                </div>
            </div>
        </div>

        <!-- P&L Itemized Table -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-list-check me-2"></i>Itemized Financial Profit & Loss Statement</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100" id="pnlTable">
                        <thead class="table-dark">
                            <tr>
                                <th>SKU</th>
                                <th>Product & Variant</th>
                                <th class="text-end">Sales Revenue</th>
                                <th class="text-end">Purchase Cost</th>
                                <th class="text-end">Gross Margin</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 3: Installment Aging Tracker -->
    <div class="tab-pane fade" id="aging-pane" role="tabpanel">
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-primary border-4 p-3 rounded">
                    <small class="text-uppercase text-muted fw-bold">Total Receivables</small>
                    <h4 class="fw-bold text-primary mb-0 mt-1" id="agingTotalReceivables">PKR 0.00</h4>
                    <small class="text-muted">Uncollected Installments</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-info border-4 p-3 rounded">
                    <small class="text-uppercase text-muted fw-bold">Due Today</small>
                    <h4 class="fw-bold text-info mb-0 mt-1" id="agingDueToday">PKR 0.00</h4>
                    <small class="text-muted">Requires Collection Today</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-warning border-4 p-3 rounded">
                    <small class="text-uppercase text-muted fw-bold">Overdue (1-30 Days)</small>
                    <h4 class="fw-bold text-warning mb-0 mt-1" id="agingOverdue1To30">PKR 0.00</h4>
                    <small class="text-muted">Mild Delay</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-0 border-start border-danger border-4 p-3 rounded bg-danger bg-opacity-10">
                    <small class="text-uppercase text-danger fw-bold">Critical Overdue (31+ Days)</small>
                    <h4 class="fw-bold text-danger mb-0 mt-1" id="agingOverdue30Plus">PKR 0.00</h4>
                    <small class="text-muted">Urgent Action Required</small>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-clock-rotate-left me-2"></i>Receivables Aging & Overdue Directory</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle w-100" id="agingTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Invoice</th>
                                <th>Customer</th>
                                <th>Product</th>
                                <th>Inst #</th>
                                <th class="text-end">Balance Due</th>
                                <th>Due Date</th>
                                <th class="text-center">Days Overdue</th>
                                <th>Aging Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 4: Customer Statement Report -->
    <div class="tab-pane fade" id="customer-pane" role="tabpanel">
        <!-- Customer Select & Date Filter Bar -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3 bg-light rounded d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 400px;">
                    <label for="custReportSelect" class="fw-bold text-dark mb-0 text-nowrap"><i class="fas fa-user-circle me-1 text-primary"></i>Customer:</label>
                    <select id="custReportSelect" class="form-select form-select-sm">
                        <option value="">-- Select Customer --</option>
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-bold text-dark"><i class="fas fa-calendar-alt me-1"></i>Date Range:</span>
                    <input type="date" id="custStartDate" class="form-control form-control-sm" style="width: 140px;" />
                    <span>to</span>
                    <input type="date" id="custEndDate" class="form-control form-control-sm" style="width: 140px;" />
                    <button id="btnFilterCustReport" class="btn btn-primary btn-sm"><i class="fas fa-search me-1"></i>Filter</button>
                    <button id="btnPrintCustStatement" class="btn btn-dark btn-sm ms-2"><i class="fas fa-print me-1"></i>Print Statement</button>
                </div>
            </div>
        </div>

        <!-- Customer Profile & Financial Summary Cards -->
        <div class="row g-3 mb-4">
            <!-- Selected Customer Info Card -->
            <div class="col-md-4 col-xl-3">
                <div class="card shadow-sm border-0 border-start border-dark border-4 p-3 rounded h-100 bg-white">
                    <small class="text-uppercase text-muted fw-bold mb-1 d-block"><i class="fas fa-id-card me-1 text-dark"></i>Customer Info</small>
                    <h5 class="fw-bold text-dark mb-1" id="custProfileName">Select a Customer</h5>
                    <div class="small text-muted mb-1" id="custProfileEmail"><i class="fas fa-envelope me-1"></i>-</div>
                    <div class="small text-muted mb-1" id="custProfilePhone"><i class="fas fa-phone me-1"></i>-</div>
                    <div class="small text-muted" id="custProfileCnic"><i class="fas fa-address-card me-1"></i>CNIC: -</div>
                </div>
            </div>
            
            <div class="col-md-4 col-xl-2">
                <div class="card shadow-sm border-0 border-start border-info border-4 p-3 rounded h-100 bg-white">
                    <small class="text-uppercase text-muted fw-bold">Total Orders</small>
                    <h4 class="fw-bold text-info mb-0 mt-2" id="custTotalOrders">0</h4>
                    <small class="text-muted">Invoices Count</small>
                </div>
            </div>

            <div class="col-md-4 col-xl-2">
                <div class="card shadow-sm border-0 border-start border-primary border-4 p-3 rounded h-100 bg-white">
                    <small class="text-uppercase text-muted fw-bold">Total Purchases</small>
                    <h5 class="fw-bold text-primary mb-0 mt-2" id="custTotalSales">PKR 0.00</h5>
                    <small class="text-muted">Sales Volume</small>
                </div>
            </div>

            <div class="col-md-6 col-xl-2">
                <div class="card shadow-sm border-0 border-start border-success border-4 p-3 rounded h-100 bg-white">
                    <small class="text-uppercase text-muted fw-bold">Total Paid</small>
                    <h5 class="fw-bold text-success mb-0 mt-2" id="custTotalPaid">PKR 0.00</h5>
                    <small class="text-muted">Cleared Receipts</small>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card shadow-sm border-0 border-start border-danger border-4 p-3 rounded h-100 bg-white">
                    <small class="text-uppercase text-danger fw-bold">Balance Outstanding</small>
                    <h4 class="fw-bold text-danger mb-0 mt-2" id="custBalanceDue">PKR 0.00</h4>
                    <small class="text-muted">Unpaid Receivable</small>
                </div>
            </div>
        </div>

        <!-- Customer Transaction Ledger Table -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-file-invoice me-2"></i>Customer Transaction Ledger</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle w-100" id="customerReportTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Items Purchased</th>
                                <th>Payment Mode</th>
                                <th>Method</th>
                                <th class="text-end">Total Amount</th>
                                <th class="text-end">Paid Amount</th>
                                <th class="text-end">Balance Due</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
