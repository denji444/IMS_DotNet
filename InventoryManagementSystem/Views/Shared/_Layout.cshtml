@inject Microsoft.AspNetCore.Identity.UserManager<InventoryManagementSystem.Models.ApplicationUser> UserManager
@inject InventoryManagementSystem.Data.InventoryDbContext DbContext
@{
    InventoryManagementSystem.Models.ApplicationUser? currentUser = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.FindByNameAsync(User.Identity.Name!);
    }
    var companyProfile = await DbContext.CompanyProfiles.FirstOrDefaultAsync() 
        ?? new InventoryManagementSystem.Models.CompanyProfile();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Third Party CSS CDNs -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventoryManagementSystem.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div id="wrapper">
        <!-- Sidebar -->
        <div id="sidebar-wrapper">
            <div class="sidebar-heading text-center text-white py-4 border-bottom">
                <a class="text-white text-decoration-none fw-bold fs-4 d-block mb-1" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-warehouse me-2"></i><span class="nav-text">IMS Portal</span>
                </a>
                <small class="text-white-50 d-block nav-text" style="font-size: 0.65rem; letter-spacing: 1px; text-transform: uppercase;">Inventory Management System</small>
            </div>
            <div class="list-group list-group-flush my-3 flex-grow-1">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
                    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
                    var currentTab = Context.Request.Query["tab"].ToString().ToLower();

                    bool isInventoryActive = currentController == "Products";
                    bool isPurchasingActive = currentController == "Purchases" || currentController == "Suppliers";
                    bool isSalesActive = currentController == "Sales" || currentController == "Customers";
                    bool isSettingsActive = currentController == "MasterSettings" && (currentTab == "company" || currentTab == "smtp");
                    bool isHrActive = currentController == "MasterSettings" && !isSettingsActive;
                    bool isDashboardActive = currentController == "Admin";
                    bool isReportsActive = currentController == "Reports";

                    bool HasAccess(string mod) => User.IsInRole("Admin") || User.HasClaim("Permission", mod);

                    <!-- Dashboard -->
                    @if (HasAccess("Dashboard"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="list-group-item list-group-item-action @(isDashboardActive ? "active-link" : "")">
                            <i class="fas fa-chart-line me-2"></i><span class="nav-text">Dashboard</span>
                        </a>
                    }

                    <!-- 1. Inventory & Catalog (Products + Categories & Types) -->
                    @if (HasAccess("Inventory"))
                    {
                        <a href="#inventoryCollapse" data-bs-toggle="collapse" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between @(isInventoryActive ? "active-link" : "")" aria-expanded="@(isInventoryActive ? "true" : "false")">
                            <div>
                                <i class="fas fa-boxes-stacked me-2"></i>
                                <span class="nav-text">Inventory & Catalog</span>
                            </div>
                            <i class="fas fa-chevron-down nav-text ms-auto transition-transform" style="font-size: 0.8rem;"></i>
                        </a>
                        <div class="collapse @(isInventoryActive ? "show" : "")" id="inventoryCollapse">
                            <div class="sidebar-submenu py-1 ms-3 border-start border-secondary" style="border-width: 2px !important;">
                                <a id="side-nav-products" asp-controller="Products" asp-action="Index" asp-route-tab="products" class="list-group-item list-group-item-action py-2 ps-4 @(isInventoryActive && (currentTab == "products" || string.IsNullOrEmpty(currentTab)) ? "active-sublink" : "")">
                                    <i class="fas fa-box-open me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Products Catalog</span>
                                </a>
                                <a id="side-nav-categories" asp-controller="Products" asp-action="Index" asp-route-tab="categories" class="list-group-item list-group-item-action py-2 ps-4 @(isInventoryActive && currentTab == "categories" ? "active-sublink" : "")">
                                    <i class="fas fa-tags me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Categories & Types</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- 2. Purchasing & Inbound (Purchases + Suppliers) -->
                    @if (HasAccess("Purchases"))
                    {
                        <a href="#purchasingCollapse" data-bs-toggle="collapse" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between @(isPurchasingActive ? "active-link" : "")" aria-expanded="@(isPurchasingActive ? "true" : "false")">
                            <div>
                                <i class="fas fa-cart-flatbed me-2"></i>
                                <span class="nav-text">Purchase</span>
                            </div>
                            <i class="fas fa-chevron-down nav-text ms-auto transition-transform" style="font-size: 0.8rem;"></i>
                        </a>
                        <div class="collapse @(isPurchasingActive ? "show" : "")" id="purchasingCollapse">
                            <div class="sidebar-submenu py-1 ms-3 border-start border-secondary" style="border-width: 2px !important;">
                                <a id="side-nav-purchases" asp-controller="Purchases" asp-action="Index" asp-route-tab="purchases" class="list-group-item list-group-item-action py-2 ps-4 @(isPurchasingActive && (currentTab == "purchases" || string.IsNullOrEmpty(currentTab)) ? "active-sublink" : "")">
                                    <i class="fas fa-file-invoice-dollar me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Purchases Directory </span>
                                </a>
                                <a id="side-nav-suppliers" asp-controller="Purchases" asp-action="Index" asp-route-tab="suppliers" class="list-group-item list-group-item-action py-2 ps-4 @(isPurchasingActive && currentTab == "suppliers" ? "active-sublink" : "")">
                                    <i class="fas fa-truck-field me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Suppliers Directory</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- 3. Sales & Outbound (Sales + Customers) -->
                    @if (HasAccess("Sales"))
                    {
                        <a href="#salesCollapse" data-bs-toggle="collapse" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between @(isSalesActive ? "active-link" : "")" aria-expanded="@(isSalesActive ? "true" : "false")">
                            <div>
                                <i class="fas fa-cash-register me-2"></i>
                                <span class="nav-text">Sales & Outbound</span>
                            </div>
                            <i class="fas fa-chevron-down nav-text ms-auto transition-transform" style="font-size: 0.8rem;"></i>
                        </a>
                        <div class="collapse @(isSalesActive ? "show" : "")" id="salesCollapse">
                            <div class="sidebar-submenu py-1 ms-3 border-start border-secondary" style="border-width: 2px !important;">
                                <a id="side-nav-sales" asp-controller="Sales" asp-action="Index" asp-route-tab="sales" class="list-group-item list-group-item-action py-2 ps-4 @(isSalesActive && (currentTab == "sales" || string.IsNullOrEmpty(currentTab)) ? "active-sublink" : "")">
                                    <i class="fas fa-file-export me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Sales / Stock Out</span>
                                </a>
                                <a id="side-nav-customers" asp-controller="Sales" asp-action="Index" asp-route-tab="customers" class="list-group-item list-group-item-action py-2 ps-4 @(isSalesActive && currentTab == "customers" ? "active-sublink" : "")">
                                    <i class="fas fa-users me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Customers Directory</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- 4. Staff & HR (Employees, Departments, Attendance, Leaves) -->
                    @if (HasAccess("Staff"))
                    {
                        <a href="#hrCollapse" data-bs-toggle="collapse" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between @(isHrActive ? "active-link" : "")" aria-expanded="@(isHrActive ? "true" : "false")">
                            <div>
                                <i class="fas fa-user-tie me-2"></i>
                                <span class="nav-text">Staff & HR</span>
                            </div>
                            <i class="fas fa-chevron-down nav-text ms-auto transition-transform" style="font-size: 0.8rem;"></i>
                        </a>
                        <div class="collapse @(isHrActive ? "show" : "")" id="hrCollapse">
                            <div class="sidebar-submenu py-1 ms-3 border-start border-secondary" style="border-width: 2px !important;">
                                <a id="side-nav-employees" asp-controller="MasterSettings" asp-action="Index" asp-route-tab="employees" class="list-group-item list-group-item-action py-2 ps-4 @(isHrActive && (currentTab == "employees" || string.IsNullOrEmpty(currentTab)) ? "active-sublink" : "")">
                                    <i class="fas fa-users-cog me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Employee Directory</span>
                                </a>
                                <a id="side-nav-departments" asp-controller="MasterSettings" asp-action="Index" asp-route-tab="departments" class="list-group-item list-group-item-action py-2 ps-4 @(isHrActive && currentTab == "departments" ? "active-sublink" : "")">
                                    <i class="fas fa-sitemap me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Departments</span>
                                </a>
                                <a id="side-nav-attendance" asp-controller="MasterSettings" asp-action="Index" asp-route-tab="attendance" class="list-group-item list-group-item-action py-2 ps-4 @(isHrActive && currentTab == "attendance" ? "active-sublink" : "")">
                                    <i class="fas fa-user-clock me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Attendance Log</span>
                                </a>
                                <a id="side-nav-leaves" asp-controller="MasterSettings" asp-action="Index" asp-route-tab="leaves" class="list-group-item list-group-item-action py-2 ps-4 @(isHrActive && currentTab == "leaves" ? "active-sublink" : "")">
                                    <i class="fas fa-calendar-times me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Leave Requests</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- 5. Settings & Setup (Company Profile, SMTP) -->
                    @if (HasAccess("Settings"))
                    {
                        <a href="#settingsCollapse" data-bs-toggle="collapse" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between @(isSettingsActive ? "active-link" : "")" aria-expanded="@(isSettingsActive ? "true" : "false")">
                            <div>
                                <i class="fas fa-gear me-2"></i>
                                <span class="nav-text">Settings & Setup</span>
                            </div>
                            <i class="fas fa-chevron-down nav-text ms-auto transition-transform" style="font-size: 0.8rem;"></i>
                        </a>
                        <div class="collapse @(isSettingsActive ? "show" : "")" id="settingsCollapse">
                            <div class="sidebar-submenu py-1 ms-3 border-start border-secondary" style="border-width: 2px !important;">
                                <a id="side-nav-company" asp-controller="MasterSettings" asp-action="Index" asp-route-tab="company" class="list-group-item list-group-item-action py-2 ps-4 @(isSettingsActive && (currentTab == "company" || string.IsNullOrEmpty(currentTab)) ? "active-sublink" : "")">
                                    <i class="fas fa-building me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">Company Profile</span>
                                </a>
                                <a id="side-nav-smtp" asp-controller="MasterSettings" asp-action="Index" asp-route-tab="smtp" class="list-group-item list-group-item-action py-2 ps-4 @(isSettingsActive && currentTab == "smtp" ? "active-sublink" : "")">
                                    <i class="fas fa-envelope-open-text me-2" style="font-size: 0.85rem;"></i><span class="nav-text" style="font-size: 0.9rem;">SMTP Settings</span>
                                </a>
                            </div>
                        </div>
                    }

                    <!-- 6. Reports & Analytics -->
                    @if (HasAccess("Reports"))
                    {
                        <a asp-controller="Reports" asp-action="Index" class="list-group-item list-group-item-action @(isReportsActive ? "active-link" : "")">
                            <i class="fas fa-chart-pie me-2"></i><span class="nav-text">Reports & Analytics</span>
                        </a>
                    }
                }
            </div>

            <!-- Sidebar Footer with Chrome-style Profile Dropup -->
            <div class="sidebar-footer p-3" style="border-top: 1px solid rgba(255, 255, 255, 0.08); background-color: rgba(0, 0, 0, 0.15);">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var displayName = currentUser?.FullName ?? User.Identity.Name ?? "User";
                    var userEmail = currentUser?.Email ?? "";
                    var initialLetter = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U";
                    var roleBadge = User.IsInRole("Admin") ? "Admin" : "Employee";

                    <div class="dropup w-100">
                        <button type="button" class="btn btn-link text-decoration-none text-white p-0 w-100 d-flex align-items-center justify-content-center justify-content-md-start" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold me-md-2" style="width: 36px; height: 36px; font-size: 1.1rem; min-width: 36px;">
                                @initialLetter
                            </div>
                            <div class="text-start nav-text" style="line-height: 1.2;">
                                <div class="fw-bold text-truncate text-white" style="max-width: 180px;">@displayName</div>
                                <span class="badge bg-light text-dark px-2 py-0.5 mt-1 small" style="font-size: 0.6rem;">@roleBadge</span>
                            </div>
                        </button>
                        <div class="dropdown-menu dropdown-menu-dark shadow-lg border-0 p-3 text-center" style="min-width: 260px; border-radius: 12px; margin-bottom: 12px;">
                            <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                                @initialLetter
                            </div>
                            <h6 class="fw-bold mb-1 text-white">@displayName</h6>
                            <p class="text-white-50 small mb-2 text-truncate" style="max-width: 230px;">@userEmail</p>
                            <span class="badge bg-secondary px-3 py-1.5 mb-3" style="font-size: 0.7rem; letter-spacing: 0.5px;">@roleBadge.ToUpper()</span>
                            
                            <button type="button" class="btn btn-outline-light btn-sm rounded-pill w-100 mb-2 py-1.5" data-bs-toggle="modal" data-bs-target="#manageProfileModal">
                                <i class="fas fa-user-cog me-1"></i> Manage Account
                            </button>
                            
                            <hr class="dropdown-divider border-secondary my-3">
                            
                            <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="w-100 m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm w-100 rounded-pill py-2 d-flex align-items-center justify-content-center">
                                    <i class="fas fa-sign-out-alt me-2"></i>Sign Out
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm d-flex align-items-center justify-content-center"><i class="fas fa-sign-in-alt me-md-1"></i><span class="nav-text">Sign In</span></a>
                    </div>
                }
            </div>
        </div>
        <!-- /#sidebar-wrapper -->

        <!-- Page Content -->
        <div id="page-content-wrapper">

            <div class="container-fluid px-4 py-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="border-top footer text-muted bg-white py-3 mt-auto">
                <div class="container text-center small">
                    &copy; 2026 - IMS Portal - Inventory Management System
                </div>
            </footer>
        </div>
        <!-- /#page-content-wrapper -->
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Third Party JS CDNs -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Company Profile Configuration for Global Print/Export -->
    <script>
        window.companyProfile = {
            companyName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(companyProfile.CompanyName ?? "Inventory Management System (IMS)")),
            tagline: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(companyProfile.Tagline ?? "")),
            address: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(companyProfile.Address ?? "")),
            phone: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(companyProfile.Phone ?? "")),
            email: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(companyProfile.Email ?? "")),
            logoPath: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(companyProfile.LogoPath ?? ""))
        };
    </script>

    <!-- Custom Common JS -->
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Manage Profile Modal -->
        <div class="modal fade" id="manageProfileModal" tabindex="-1" aria-labelledby="manageProfileModalLabel" aria-hidden="true" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title" id="manageProfileModalLabel"><i class="fas fa-user-cog me-2"></i>Manage Admin Account</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="manageProfileForm">
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Full Name</label>
                                <input type="text" class="form-control" id="profileFullName" value="@(currentUser?.FullName ?? "")" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Email Address</label>
                                <input type="email" class="form-control" value="@(currentUser?.Email ?? "")" disabled />
                                <div class="form-text text-muted">Email address cannot be changed.</div>
                            </div>
                            <hr class="my-4">
                            <h6 class="fw-bold mb-3"><i class="fas text-warning"></i>Change Password (Optional)</h6>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Current Password</label>
                                <input type="password" class="form-control" id="profileCurrentPassword" placeholder="Enter current password" autocomplete="off" />
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">New Password</label>
                                    <input type="password" class="form-control" id="profileNewPassword" placeholder="New password" autocomplete="off" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Confirm Password</label>
                                    <input type="password" class="form-control" id="profileConfirmPassword" placeholder="Confirm new password" autocomplete="off" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light border-0 py-3">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-dark" id="btnSaveProfile">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</body>
</html>
