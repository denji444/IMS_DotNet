@{
    ViewData["Title"] = "Welcome to IMS";
}

<div class="row align-items-center justify-content-center min-vh-75 py-5">
    <div class="col-md-8 text-dark text-center">
        <div class="mb-4">
            <i class="fas fa-warehouse text-primary fa-4x mb-3"></i>
            <h1 class="display-4 fw-bold mb-3">Inventory Management System</h1>
            <p class="lead text-muted">Smart Inventory, Multi-Item Point-of-Sale, Purchases, Installment Leases & Enterprise Tracking</p>
        </div>
        <div class="d-flex gap-3 justify-content-center">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Admin" asp-action="Index" class="btn btn-dark btn-lg px-4 shadow-sm">
                    <i class="fas fa-chart-line me-2"></i>Go to Admin Panel
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-4 shadow-sm">
                    <i class="fas fa-sign-in-alt me-2"></i>Sign In to Portal
                </a>
            }
        </div>
    </div>
</div>
