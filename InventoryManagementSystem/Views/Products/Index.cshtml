@{
    Layout = "_Layout";
    ViewData["Title"] = "Inventory & Catalog";
}

<!-- Inventory & Catalog Header -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-boxes-stacked me-2 text-primary"></i>Inventory & Catalog</h2>
                <p class="text-muted mb-0">Manage product SKU directory, categories, sub-classifications, and dynamic type attributes.</p>
            </div>
        </div>
    </div>
</div>

<!-- Inventory & Catalog Tabs -->
<ul class="nav nav-tabs nav-fill mb-4 bg-white p-2 rounded shadow-sm" id="inventoryTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="products-tab" data-bs-toggle="tab" data-bs-target="#products" type="button" role="tab" aria-controls="products">
            <i class="fas fa-box-open me-2"></i> Products Catalog
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button" role="tab" aria-controls="categories">
            <i class="fas fa-tags me-2"></i> Product Categories & Types
        </button>
    </li>
</ul>

<!-- Inventory & Catalog Tab Content -->
<div class="tab-content" id="inventoryTabsContent">
    <partial name="Partials/_ProductsTab" />
    <partial name="Partials/_CategoriesTab" />
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/products.js" asp-append-version="true"></script>
}
