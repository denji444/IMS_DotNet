@model InventoryManagementSystem.Models.ViewModels.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-chart-line me-2 text-primary"></i>Administration Dashboard</h2>
            <p class="text-muted mb-0">Real-time financial performance, inventory alerts, and sales analytics.</p>
        </div>
        <div>
            <span class="badge bg-light text-dark border p-2 fw-normal">
                <i class="fas fa-clock me-1 text-primary"></i> Last Updated: @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
            </span>
        </div>
    </div>
</div>

<!-- Row 1: Primary Financial & Inventory Value Summary (4 Cards) -->
<div class="row g-3 mb-3">
    <!-- Total Sales -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-success border-4 rounded h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-uppercase text-muted small fw-bold">Total Sales</span>
                    <i class="fas fa-dollar-sign text-success opacity-50 fs-5"></i>
                </div>
                <h4 class="fw-bold mb-0 text-success text-nowrap">PKR @Model.TotalSales.ToString("N0")</h4>
                <small class="text-muted">Lifetime Revenue</small>
            </div>
        </div>
    </div>

    <!-- Total Purchases -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-danger border-4 rounded h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-uppercase text-muted small fw-bold">Total Purchases</span>
                    <i class="fas fa-shopping-cart text-danger opacity-50 fs-5"></i>
                </div>
                <h4 class="fw-bold mb-0 text-danger text-nowrap">PKR @Model.TotalPurchases.ToString("N0")</h4>
                <small class="text-muted">Stock Outlay Cost</small>
            </div>
        </div>
    </div>

    <!-- Net Profit / Margin -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start @(Model.NetProfit >= 0 ? "border-primary" : "border-danger") border-4 rounded h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-uppercase text-muted small fw-bold">Net Margin</span>
                    <i class="fas fa-calculator @(Model.NetProfit >= 0 ? "text-primary" : "text-danger") opacity-50 fs-5"></i>
                </div>
                <h4 class="fw-bold mb-0 @(Model.NetProfit >= 0 ? "text-primary" : "text-danger") text-nowrap">PKR @Model.NetProfit.ToString("N0")</h4>
                <small class="text-muted">Sales minus Purchases</small>
            </div>
        </div>
    </div>

    <!-- Total Stock Value -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-info border-4 rounded h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-uppercase text-muted small fw-bold">Total Stock Value</span>
                    <i class="fas fa-warehouse text-info opacity-50 fs-5"></i>
                </div>
                <h4 class="fw-bold mb-0 text-dark text-nowrap">PKR @Model.TotalStockValue.ToString("N0")</h4>
                <small class="text-muted">Current Inventory Outlay</small>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Financial Obligations & Inventory Health Alerts (4 Cards) -->
<div class="row g-3 mb-3">
    <!-- Receivables -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4 rounded h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-uppercase text-muted small fw-bold">Receivables</span>
                    <i class="fas fa-hand-holding-dollar text-warning opacity-50 fs-5"></i>
                </div>
                <h4 class="fw-bold mb-0 text-warning text-nowrap">PKR @Model.PendingReceivables.ToString("N0")</h4>
                <small class="text-muted">Customer Installments</small>
            </div>
        </div>
    </div>

    <!-- Payables -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-secondary border-4 rounded h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-uppercase text-muted small fw-bold">Payables</span>
                    <i class="fas fa-file-invoice-dollar text-secondary opacity-50 fs-5"></i>
                </div>
                <h4 class="fw-bold mb-0 text-secondary text-nowrap">PKR @Model.PendingPayables.ToString("N0")</h4>
                <small class="text-muted">Supplier Installments</small>
            </div>
        </div>
    </div>

    <!-- Low Stock Alert -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start @(Model.LowStockCount > 0 ? "border-danger bg-danger bg-opacity-10" : "border-success") border-4 rounded h-100">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-uppercase text-muted small fw-bold">Low Stock Items</span>
                    <i class="fas fa-triangle-exclamation @(Model.LowStockCount > 0 ? "text-danger" : "text-success") fs-5"></i>
                </div>
                <h4 class="fw-bold mb-0 @(Model.LowStockCount > 0 ? "text-danger" : "text-success") mt-1">
                    @Model.LowStockCount <small class="fs-6 fw-normal">Items</small>
                </h4>
                <small class="text-muted">Stock &le; 5 units</small>
            </div>
        </div>
    </div>

    <!-- Overbought Alert -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start @(Model.HighStockCount > 0 ? "border-purple bg-purple bg-opacity-10" : "border-secondary") border-4 rounded h-100" style="border-left-color: #6f42c1 !important;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-uppercase text-muted small fw-bold">Overbought Stock</span>
                    <i class="fas fa-boxes-stacked fs-5" style="color: #6f42c1;"></i>
                </div>
                <h4 class="fw-bold mb-0 mt-1" style="color: #6f42c1;">
                    @Model.HighStockCount <small class="fs-6 fw-normal text-muted">Items</small>
                </h4>
                <small class="text-muted">Stock &ge; 50 units</small>
            </div>
        </div>
    </div>
</div>

<!-- Row 3: Entity Directory Counters (3 Cards) -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-white p-3 d-flex flex-row align-items-center justify-content-between rounded h-100">
            <div>
                <h6 class="text-uppercase text-muted small fw-bold mb-1">Products Active</h6>
                <h3 class="fw-bold mb-0 text-dark">@Model.ProductCount</h3>
            </div>
            <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                <i class="fas fa-box fa-xl"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-white p-3 d-flex flex-row align-items-center justify-content-between rounded h-100">
            <div>
                <h6 class="text-uppercase text-muted small fw-bold mb-1">Active Suppliers</h6>
                <h3 class="fw-bold mb-0 text-dark">@Model.SupplierCount</h3>
            </div>
            <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                <i class="fas fa-truck-field fa-xl"></i>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-white p-3 d-flex flex-row align-items-center justify-content-between rounded h-100">
            <div>
                <h6 class="text-uppercase text-muted small fw-bold mb-1">Registered Customers</h6>
                <h3 class="fw-bold mb-0 text-dark">@Model.CustomerCount</h3>
            </div>
            <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                <i class="fas fa-users fa-xl"></i>
            </div>
        </div>
    </div>
</div>

<!-- Visual Analytics Charts Row -->
<div class="row g-4 mb-4">
    <!-- Financial Trend Chart -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 rounded h-100">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fas fa-chart-bar me-2"></i>6-Month Financial Trend (Sales vs Purchases)</h6>
            </div>
            <div class="card-body p-3">
                <canvas id="financialTrendChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Top Selling Products Chart -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 rounded h-100">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fas fa-fire me-2"></i>Top 5 Selling Products</h6>
            </div>
            <div class="card-body p-3 d-flex align-items-center justify-content-center">
                @if (Model.TopProductLabels.Any())
                {
                    <canvas id="topProductsChart" style="max-height: 280px;"></canvas>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-chart-pie fa-3x mb-2 text-secondary"></i>
                        <p class="mb-0">No sales data available to render chart.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Tables Row -->
<div class="row g-4 mb-4">
    <!-- Inventory Alerts Card (Low Stock & Overbought) -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded h-100">
            <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
                <ul class="nav nav-tabs card-header-tabs border-0" id="inventoryAlertTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active text-warning fw-bold border-0 bg-transparent py-2" id="low-stock-tab" data-bs-toggle="tab" data-bs-target="#low-stock-pane" type="button" role="tab" aria-controls="low-stock-pane" aria-selected="true">
                            <i class="fas fa-triangle-exclamation me-1"></i>Low Stock (@Model.LowStockCount)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-light fw-bold border-0 bg-transparent py-2" id="high-stock-tab" data-bs-toggle="tab" data-bs-target="#high-stock-pane" type="button" role="tab" aria-controls="high-stock-pane" aria-selected="false">
                            <i class="fas fa-boxes-stacked me-1 text-info"></i>Overbought (@Model.HighStockCount)
                        </button>
                    </li>
                </ul>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-light btn-sm">Manage Stock</a>
            </div>
            <div class="card-body p-0">
                <div class="tab-content" id="inventoryAlertTabsContent">
                    <!-- Low Stock Tab -->
                    <div class="tab-pane fade show active" id="low-stock-pane" role="tabpanel" aria-labelledby="low-stock-tab">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Variant</th>
                                        <th class="text-center">Stock</th>
                                        <th class="text-end">Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.LowStockProducts.Any())
                                    {
                                        foreach (var prod in Model.LowStockProducts)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-dark">@prod.Name</div>
                                                    <small class="text-muted">SKU: @prod.Sku</small>
                                                </td>
                                                <td>@(string.IsNullOrEmpty(prod.Variant) ? "Standard" : prod.Variant)</td>
                                                <td class="text-center">
                                                    <span class="badge @(prod.StockQuantity == 0 ? "bg-danger" : "bg-warning text-dark")">
                                                        @prod.StockQuantity Units
                                                    </span>
                                                </td>
                                                <td class="text-end fw-bold">@(prod.Price.HasValue ? $"PKR {prod.Price.Value.ToString("N2")}" : "N/A")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="fas fa-check-circle text-success me-1"></i> No low stock items!
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- High Stock (Overbought) Tab -->
                    <div class="tab-pane fade" id="high-stock-pane" role="tabpanel" aria-labelledby="high-stock-tab">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Variant</th>
                                        <th class="text-center">Stock</th>
                                        <th class="text-end">Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.HighStockProducts.Any())
                                    {
                                        foreach (var prod in Model.HighStockProducts)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold text-dark">@prod.Name</div>
                                                    <small class="text-muted">SKU: @prod.Sku</small>
                                                </td>
                                                <td>@(string.IsNullOrEmpty(prod.Variant) ? "Standard" : prod.Variant)</td>
                                                <td class="text-center">
                                                    <span class="badge bg-info text-dark fw-bold">
                                                        @prod.StockQuantity Units
                                                    </span>
                                                </td>
                                                <td class="text-end fw-bold">@(prod.Price.HasValue ? $"PKR {prod.Price.Value.ToString("N2")}" : "N/A")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="fas fa-info-circle text-info me-1"></i> No overbought stock items found.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Sales Activity Table -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded h-100">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fas fa-history me-2"></i>Recent Sales Activity</h6>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-outline-light btn-sm">View All Sales</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Invoice</th>
                                <th>Product</th>
                                <th>Customer</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentSales.Any())
                            {
                                foreach (var sale in Model.RecentSales)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@sale.InvoiceNo</div>
                                            <small class="text-muted">@sale.SaleDate.ToString("dd MMM yyyy")</small>
                                        </td>
                                        <td>@(sale.Product != null ? (string.IsNullOrEmpty(sale.Product.Variant) ? sale.Product.Name : $"{sale.Product.Name} ({sale.Product.Variant})") : "N/A")</td>
                                        <td>@(sale.Customer?.FullName ?? "Guest")</td>
                                        <td class="text-end fw-bold text-success">PKR @sale.TotalAmount.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No recent sales found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Financial Trend Chart
            var trendCtx = document.getElementById('financialTrendChart').getContext('2d');
            var trendChart = new Chart(trendCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels)),
                    datasets: [
                        {
                            label: 'Sales Revenue (PKR)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesData)),
                            backgroundColor: 'rgba(25, 135, 84, 0.75)',
                            borderColor: 'rgba(25, 135, 84, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Purchase Cost (PKR)',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyPurchasesData)),
                            backgroundColor: 'rgba(220, 53, 69, 0.75)',
                            borderColor: 'rgba(220, 53, 69, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': PKR ' + parseFloat(context.raw).toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'PKR ' + value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });

            // Top Products Chart
            @if (Model.TopProductLabels.Any())
            {
                <text>
                var topCtx = document.getElementById('topProductsChart').getContext('2d');
                var topChart = new Chart(topCtx, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProductLabels)),
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProductQuantities)),
                            backgroundColor: [
                                '#0d6efd',
                                '#198754',
                                '#ffc107',
                                '#0dcaf0',
                                '#6c757d'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
                </text>
            }
        });
    </script>
}
