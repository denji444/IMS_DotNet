@model List<InventoryManagementSystem.Models.Sale>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-light"><i class="fas fa-chart-line me-2"></i>Administration Dashboard</h2>
        <hr />
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Total Products Card -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-primary border-5 rounded">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-secondary small fw-bold mb-1">Total Products</h6>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.ProductCount</h3>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                    <i class="fas fa-box fa-2x"></i>
                </div>
            </div>
            <div class="card-footer bg-white border-0 py-2 d-flex justify-content-between align-items-center">
                <a asp-controller="Products" asp-action="Index" class="text-primary text-decoration-none small">Manage Products <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>

    <!-- Total Suppliers Card -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-5 rounded">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-secondary small fw-bold mb-1">Suppliers</h6>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.SupplierCount</h3>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                    <i class="fas fa-truck-field fa-2x"></i>
                </div>
            </div>
            <div class="card-footer bg-white border-0 py-2 d-flex justify-content-between align-items-center">
                <a asp-controller="Suppliers" asp-action="Index" class="text-success text-decoration-none small">Manage Suppliers <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>

    <!-- Total Customers Card -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-info border-5 rounded">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-secondary small fw-bold mb-1">Customers</h6>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.CustomerCount</h3>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                    <i class="fas fa-users fa-2x"></i>
                </div>
            </div>
            <div class="card-footer bg-white border-0 py-2 d-flex justify-content-between align-items-center">
                <a asp-controller="Customers" asp-action="Index" class="text-info text-decoration-none small">Manage Customers <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Sales Table -->
    <div class="col-12">
        <div class="card shadow-sm border-0 mb-4 rounded">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Recent Sales / Stock Out Activity</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>Invoice No</th>
                                <th>Product Name</th>
                                <th>Customer Name</th>
                                <th>Quantity</th>
                                <th>Total Cost</th>
                                <th>Sale Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                foreach (var sale in Model)
                                {
                                    <tr>
                                        <td><strong>@sale.InvoiceNo</strong></td>
                                        <td>@(sale.Product?.Name ?? "N/A")</td>
                                        <td>@(sale.Customer?.FullName ?? "N/A")</td>
                                        <td>@sale.Quantity</td>
                                        <td>PKR @sale.TotalAmount.ToString("F2")</td>
                                        <td>@sale.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-3">No recent sales activity found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
