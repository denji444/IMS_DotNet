@model InventoryManagementSystem.Models.Sale
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Sales / Stock Out";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
        <h4 class="mb-0"><i class="fas fa-file-export me-2"></i>Sales & Stock Out Directory</h4>
        <button class="btn btn-light btn-sm" onclick="openCreateModal()">
            <i class="fas fa-plus me-1"></i> Record Sale / Stock Out
        </button>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover table-striped w-100" id="salesTable">
                <thead class="table-dark">
                    <tr>
                        <th>Invoice No</th>
                        <th>Product</th>
                        <th>Customer</th>
                        <th>Qty</th>
                        <th>Unit Price</th>
                        <th>Total Amount</th>
                        <th>Sale Date</th>
                        <th>Notes</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Loaded dynamically via DataTables AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Sale Create/Edit Modal -->
<div class="modal fade" id="saleModal" role="dialog" aria-labelledby="saleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="saleModalLabel">Record Sale</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="saleForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="saleId" name="Id" value="0" />
                
                <div class="modal-body p-4">
                    <div class="mb-3" id="customerSelectContainer">
                        <label asp-for="CustomerId" class="form-label text-secondary small fw-bold mb-1"></label>
                        <select asp-for="CustomerId" class="form-select select2-customer w-100" id="customerSelect" required>
                            <!-- Remotely bound -->
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>

                    <div class="form-check form-switch mb-3" id="newCustomerToggleContainer">
                        <input class="form-check-input" type="checkbox" id="newCustomerToggle">
                        <label class="form-check-label text-secondary small fw-bold" for="newCustomerToggle">New Customer?</label>
                    </div>

                    <div id="newCustomerFields" class="d-none border rounded p-3 mb-3 bg-light">
                        <h6 class="text-dark mb-3 fw-bold"><i class="fas fa-user-plus me-2"></i>New Customer Details</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" id="newCustomerFirstName" placeholder="First Name" />
                                    <label for="newCustomerFirstName">First Name</label>
                                    <span class="text-danger small" id="newCustomerFirstNameError"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" id="newCustomerLastName" placeholder="Last Name" />
                                    <label for="newCustomerLastName">Last Name</label>
                                    <span class="text-danger small" id="newCustomerLastNameError"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" type="email" id="newCustomerEmail" placeholder="Email" />
                                    <label for="newCustomerEmail">Email Address</label>
                                    <span class="text-danger small" id="newCustomerEmailError"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" id="newCustomerPhone" placeholder="Phone" />
                                    <label for="newCustomerPhone">Phone Number</label>
                                    <span class="text-danger small" id="newCustomerPhoneError"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProductId" class="form-label text-secondary small fw-bold mb-1"></label>
                        <select asp-for="ProductId" class="form-select select2-product w-100" id="productSelect" required>
                            <!-- Remotely bound -->
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger"></span>
                        <div id="availableStockContainer" class="form-text mt-1 d-none">
                            <div>Available Stock: <span id="availableStockQty" class="fw-bold">0</span></div>
                            <div id="setUnitPriceContainer" class="mt-1">Set Unit Price: <span id="setUnitPriceValue" class="fw-bold text-dark">PKR 0.00</span></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Quantity" class="form-control" type="number" id="saleQty" placeholder="Quantity" required min="1" />
                                <label asp-for="Quantity"></label>
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" id="unitPrice" placeholder="Unit Price" required min="0.01" />
                                <label asp-for="UnitPrice"></label>
                                <span asp-validation-for="UnitPrice" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="TotalAmount" class="form-control bg-light" type="number" id="totalAmount" placeholder="Total Amount" readonly />
                        <label asp-for="TotalAmount"></label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold mb-1">Payment Mode</label>
                        <select asp-for="PaymentMode" class="form-select" id="paymentMode" required>
                            <option value="0">Full Payment</option>
                            <option value="1">Lease / Installments</option>
                        </select>
                        <span asp-validation-for="PaymentMode" class="text-danger"></span>
                    </div>

                    <div id="leaseFields" class="d-none border rounded p-3 mb-3 bg-light">
                        <h6 class="text-dark mb-3 fw-bold"><i class="fas fa-calendar-alt me-2"></i>Lease Configuration</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DownPayment" class="form-label text-secondary small fw-bold mb-1"></label>
                                <input asp-for="DownPayment" class="form-control" type="number" id="downPayment" placeholder="Down Payment" min="0" step="0.01" value="0.00" />
                                <span asp-validation-for="DownPayment" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="InstallmentFrequency" class="form-label text-secondary small fw-bold mb-1"></label>
                                <select asp-for="InstallmentFrequency" class="form-select" id="installmentFrequency">
                                    <option value="Monthly">Monthly</option>
                                    <option value="Weekly">Weekly</option>
                                </select>
                                <span asp-validation-for="InstallmentFrequency" class="text-danger"></span>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label asp-for="InstallmentsCount" class="form-label text-secondary small fw-bold mb-1">Installments Count</label>
                                <input asp-for="InstallmentsCount" class="form-control" type="number" id="installmentsCount" placeholder="Number of Installments" min="1" value="3" />
                                <span asp-validation-for="InstallmentsCount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="text-dark small fw-bold" id="leaseEstimate"></div>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Notes" class="form-control" id="notes" placeholder="Notes" style="height: 80px;"></textarea>
                        <label asp-for="Notes"></label>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark" id="btnSaveSale">Save Sale</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Lease Installment Modal -->
<div class="modal fade" id="leaseScheduleModal" tabindex="-1" role="dialog" aria-labelledby="leaseScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="leaseScheduleModalLabel"><i class="fas fa-calendar-alt me-2"></i>Lease Installment Collection Schedule</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-3 bg-light p-3 rounded border mx-0">
                    <div class="col-md-6 mb-2">
                        <span class="text-secondary small fw-bold">Invoice Number:</span>
                        <div id="leaseInvoiceNo" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <span class="text-secondary small fw-bold">Total Amount:</span>
                        <div id="leaseTotalCost" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-secondary small fw-bold">Down Payment:</span>
                        <div id="leaseDownPayment" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-secondary small fw-bold">Remaining Balance:</span>
                        <div id="leaseRemainingBalance" class="fw-bold text-dark">-</div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100 align-middle" id="leaseScheduleTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Installment #</th>
                                <th>Due Date</th>
                                <th>Amount</th>
                                <th>Collected</th>
                                <th>Collection Date</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="leaseScheduleBody">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales.js" asp-append-version="true"></script>
}
