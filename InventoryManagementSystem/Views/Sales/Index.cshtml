    @model InventoryManagementSystem.Models.Sale
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Sales / Stock Out";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
        <h4 class="mb-0"><i class="fas fa-file-export me-2"></i>Sales & Stock Out Directory</h4>
        <button class="btn btn-light btn-sm" onclick="openCreateModal()">
            <i class="fas fa-plus me-1"></i> Record Sale / Stock Out
        </button>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle w-100" id="salesTable">
                <thead class="table-dark text-center">
                    <tr>
                        <th class="text-center">Invoice & Date</th>
                        <th class="text-center">Product & Batch</th>
                        <th class="text-center">Customer</th>
                        <th class="text-center">Total Amount</th>
                        <th class="text-center">Notes</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Loaded dynamically via DataTables AJAX -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Sale Create/Edit Modal -->
<div class="modal fade" id="saleModal" role="dialog" aria-labelledby="saleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="saleModalLabel">Record Sale</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="saleForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="saleId" name="Id" value="0" />
                
                <div class="modal-body p-4">
                    <div class="mb-3" id="customerSelectContainer">
                        <label asp-for="CustomerId" class="form-label text-secondary small fw-bold mb-1"></label>
                        <select asp-for="CustomerId" class="form-select select2-customer w-100" id="customerSelect" required>
                            <!-- Remotely bound -->
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>

                    <div class="form-check form-switch mb-3" id="newCustomerToggleContainer">
                        <input class="form-check-input" type="checkbox" id="newCustomerToggle">
                        <label class="form-check-label text-secondary small fw-bold" for="newCustomerToggle">New Customer?</label>
                    </div>

                    <div id="newCustomerFields" class="d-none border rounded p-3 mb-3 bg-light">
                        <h6 class="text-dark mb-3 fw-bold"><i class="fas fa-user-plus me-2"></i>New Customer Details</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" id="newCustomerFirstName" placeholder="First Name" />
                                    <label for="newCustomerFirstName">First Name</label>
                                    <span class="text-danger small" id="newCustomerFirstNameError"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" id="newCustomerLastName" placeholder="Last Name" />
                                    <label for="newCustomerLastName">Last Name</label>
                                    <span class="text-danger small" id="newCustomerLastNameError"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" type="email" id="newCustomerEmail" placeholder="Email" />
                                    <label for="newCustomerEmail">Email Address</label>
                                    <span class="text-danger small" id="newCustomerEmailError"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input class="form-control" id="newCustomerPhone" placeholder="Phone" />
                                    <label for="newCustomerPhone">Phone Number</label>
                                    <span class="text-danger small" id="newCustomerPhoneError"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-floating mb-1">
                            <input class="form-control cnic-input" id="newCustomerCnic" placeholder="CNIC No" maxlength="15" />
                            <label for="newCustomerCnic">CNIC No (Optional, e.g. 35201-1234567-1)</label>
                        </div>
                    </div>

                    <!-- Multi-Item Invoice Builder -->
                    <div class="border rounded p-3 mb-3 bg-light">
                        <h6 class="text-dark mb-3 fw-bold"><i class="fas fa-boxes text-primary me-2"></i>Invoice Items Selection</h6>
                        
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label text-secondary small fw-bold mb-1">Filter Category</label>
                                <select class="form-select form-select-sm" id="itemCategoryFilter">
                                    <option value="">-- All Categories --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-secondary small fw-bold mb-1">Filter Product Type</label>
                                <select class="form-select form-select-sm" id="itemTypeFilter">
                                    <option value="">-- All Product Types --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <div class="col-md-7">
                                <label class="form-label text-secondary small fw-bold mb-1">Select Product SKU</label>
                                <select class="form-select select2-product w-100" id="productSelect">
                                    <!-- Remotely bound -->
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label text-secondary small fw-bold mb-1"><i class="fas fa-layer-group text-primary me-1"></i>Stock Batch</label>
                                <select class="form-select form-select-sm" id="saleBatchSelect">
                                    <option value="">-- General / Unbatched Stock --</option>
                                </select>
                            </div>
                        </div>

                        <!-- 3-Tier Rates Display & Info Banner -->
                        <div id="batchRatesContainer" class="p-2 mb-2 bg-white rounded border d-none">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 small">
                                <div>
                                    <span class="badge bg-secondary me-1"><i class="fas fa-boxes-stacked me-1"></i>Available Stock: <span id="availableStockQty">0</span></span>
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    <span class="badge bg-secondary text-white" title="Batch Purchase Cost"><i class="fas fa-shopping-cart me-1"></i>Purchase Rate: <span id="batchPurchaseRateDisplay">N/A</span></span>
                                    <span class="badge bg-warning text-dark" title="Minimum Selling Floor"><i class="fas fa-shield-halved me-1"></i>Fix Rate (Min): <span id="batchFixRateDisplay">N/A</span></span>
                                    <span class="badge bg-success text-white" title="Target Selling Price"><i class="fas fa-tag me-1"></i>Demand Rate: <span id="batchDemandRateDisplay">N/A</span></span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label text-secondary small fw-bold mb-1">Quantity</label>
                                <input class="form-control form-control-sm" type="number" id="saleQty" min="1" value="1" placeholder="Qty" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-secondary small fw-bold mb-1" title="Selling Price (Demand Rate)">
                                    <i class="fas fa-money-bill-wave text-success me-1"></i>Selling Price / Demand Rate (PKR)
                                </label>
                                <input class="form-control form-control-sm fw-bold border-primary" type="number" step="0.01" id="unitPrice" placeholder="Selling Price (Demand Rate)" />
                               
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-primary btn-sm w-100" id="btnAddSaleItem">
                                    <i class="fas fa-plus me-1"></i> Add Item
                                </button>
                            </div>
                        </div>

                        <!-- Draft Items Table -->
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered bg-white align-middle text-center mb-0" id="saleItemsTable">
                                <thead class="table-dark small">
                                    <tr>
                                        <th style="width: 35%;">Product</th>
                                        <th style="width: 20%;">Batch</th>
                                        <th style="width: 12%;">Qty</th>
                                        <th style="width: 15%;">Unit Price</th>
                                        <th style="width: 15%;">Total</th>
                                        <th style="width: 3%;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="saleItemsTableBody">
                                    <tr id="emptySaleItemsRow">
                                        <td colspan="6" class="text-muted small py-3">No items added to invoice yet. Select a product and click "Add Item".</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="TotalAmount" class="form-control bg-light fw-bold text-dark fs-5" type="number" id="totalAmount" placeholder="Total Amount" readonly />
                        <label asp-for="TotalAmount" class="fw-bold">Grand Total Amount (PKR)</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold mb-1">Payment Mode</label>
                        <select asp-for="PaymentMode" class="form-select" id="paymentMode" required>
                            <option value="0">Full Payment</option>
                            <option value="1">Lease / Installments</option>
                        </select>
                        <span asp-validation-for="PaymentMode" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small fw-bold mb-1"><i class="fas fa-credit-card me-1 text-primary"></i>Payment Method</label>
                        <select asp-for="PaymentMethod" class="form-select" id="paymentMethod" required>
                            <option value="0">Cash</option>
                            <option value="1">Check</option>
                            <option value="2">Online Transfer</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                    </div>

                    <!-- Dynamic Payment Method Details -->
                    <div id="paymentMethodDetailsContainer" class="border rounded p-3 mb-3 bg-light">
                        <!-- Cash Options -->
                        <div id="cashFields" class="payment-method-fields">
                            <h6 class="text-dark mb-2 fw-bold"><i class="fas fa-money-bill-wave text-success me-2"></i>Cash Details</h6>
                            <div class="form-floating">
                                <input class="form-control" id="cashReference" placeholder="Receipt / Ref #" />
                                <label for="cashReference">Receipt / Ref # (Optional)</label>
                            </div>
                        </div>
                        <!-- Check Options -->
                        <div id="checkFields" class="payment-method-fields d-none">
                            <h6 class="text-dark mb-2 fw-bold"><i class="fas fa-money-check text-warning me-2"></i>Check Details</h6>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" id="checkBankName" placeholder="Bank Name" />
                                        <label for="checkBankName">Bank Name</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" id="checkNumber" placeholder="Check Number" />
                                        <label for="checkNumber">Check Number</label>
                                    </div>
                                </div>
                                <div class="col-md-12 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" type="date" id="checkDate" placeholder="Check Date" />
                                        <label for="checkDate">Check Date</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Online Transfer Options -->
                        <div id="onlineTransferFields" class="payment-method-fields d-none">
                            <h6 class="text-dark mb-2 fw-bold"><i class="fas fa-university text-info me-2"></i>Online Transfer Details</h6>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" id="transferBankName" placeholder="Bank / Platform Name" />
                                        <label for="transferBankName">Bank / Platform (e.g. Meezan, JazzCash)</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <div class="form-floating">
                                        <input class="form-control" id="transferTxnId" placeholder="Transaction / Ref ID" />
                                        <label for="transferTxnId">Transaction / Ref ID</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="leaseFields" class="d-none border rounded p-3 mb-3 bg-light">
                        <h6 class="text-dark mb-3 fw-bold"><i class="fas fa-calendar-alt me-2"></i>Lease Configuration</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DownPayment" class="form-label text-secondary small fw-bold mb-1"></label>
                                <input asp-for="DownPayment" class="form-control" type="number" id="downPayment" placeholder="Down Payment" min="0" step="0.01" value="0.00" />
                                <span asp-validation-for="DownPayment" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="InstallmentFrequency" class="form-label text-secondary small fw-bold mb-1"></label>
                                <select asp-for="InstallmentFrequency" class="form-select" id="installmentFrequency">
                                    <option value="Monthly">Monthly</option>
                                    <option value="Weekly">Weekly</option>
                                </select>
                                <span asp-validation-for="InstallmentFrequency" class="text-danger"></span>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label asp-for="InstallmentsCount" class="form-label text-secondary small fw-bold mb-1">Installments Count</label>
                                <input asp-for="InstallmentsCount" class="form-control" type="number" id="installmentsCount" placeholder="Number of Installments" min="1" value="3" />
                                <span asp-validation-for="InstallmentsCount" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="text-dark small fw-bold" id="leaseEstimate"></div>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Notes" class="form-control" id="notes" placeholder="Notes" style="height: 80px;"></textarea>
                        <label asp-for="Notes"></label>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark" id="btnSaveSale">Save Sale</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Lease Installment Modal -->
<div class="modal fade" id="leaseScheduleModal" tabindex="-1" role="dialog" aria-labelledby="leaseScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="leaseScheduleModalLabel"><i class="fas fa-calendar-alt me-2"></i>Lease Installment Collection Schedule</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row mb-3 bg-light p-3 rounded border mx-0">
                    <div class="col-md-6 mb-2">
                        <span class="text-secondary small fw-bold">Invoice Number:</span>
                        <div id="leaseInvoiceNo" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <span class="text-secondary small fw-bold">Total Amount:</span>
                        <div id="leaseTotalCost" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-secondary small fw-bold">Down Payment:</span>
                        <div id="leaseDownPayment" class="fw-bold text-dark">-</div>
                    </div>
                    <div class="col-md-6">
                        <span class="text-secondary small fw-bold">Remaining Balance:</span>
                        <div id="leaseRemainingBalance" class="fw-bold text-dark">-</div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100 align-middle" id="leaseScheduleTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Installment #</th>
                                <th>Due Date</th>
                                <th>Amount</th>
                                <th>Collected</th>
                                <th>Collection Date</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="leaseScheduleBody">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales.js" asp-append-version="true"></script>
}
