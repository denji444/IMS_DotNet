@{
    Layout = "_Layout";
    ViewData["Title"] = "Sales & Outbound";
}

<!-- Sales & Outbound Header -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-cash-register me-2 text-primary"></i>Sales & Outbound</h2>
                <p class="text-muted mb-0">Manage customer sales invoices, stock out dispatches, invoice settlements, and customer directory.</p>
            </div>
        </div>
    </div>
</div>

<!-- Sales & Outbound Tabs -->
<ul class="nav nav-tabs nav-fill mb-4 bg-white p-2 rounded shadow-sm" id="salesTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="sales-tab" data-bs-toggle="tab" data-bs-target="#sales" type="button" role="tab" aria-controls="sales">
            <i class="fas fa-file-export me-2"></i> Sales / Stock Out
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="customers-tab" data-bs-toggle="tab" data-bs-target="#customers" type="button" role="tab" aria-controls="customers">
            <i class="fas fa-users me-2"></i> Customers Directory
        </button>
    </li>
</ul>

<!-- Sales & Outbound Tab Content -->
<div class="tab-content" id="salesTabsContent">
    <partial name="Partials/_SalesTab" />
    <partial name="Partials/_CustomersTab" />
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/sales.js" asp-append-version="true"></script>
    <script src="~/js/customers.js" asp-append-version="true"></script>
}
