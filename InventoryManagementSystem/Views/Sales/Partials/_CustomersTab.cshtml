@model InventoryManagementSystem.Models.ViewModels.CustomerInputModel

<div class="tab-pane fade" id="customers" role="tabpanel" aria-labelledby="customers-tab">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="fas fa-users me-2"></i>Customers Registry</h5>
            <button class="btn btn-primary btn-sm" onclick="openCustomerCreateModal()">
                <i class="fas fa-plus me-1"></i> Add Customer
            </button>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle w-100" id="customersTable">
                     <thead class="table-dark text-center">
                        <tr>
                            <th class="text-center">Full Name</th>
                            <th class="text-center">Contact Info (Email & Phone)</th>
                            <th class="text-center">CNIC No</th>
                            <th class="text-center">Created Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Loaded dynamically via DataTables AJAX -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Customer Add/Edit Modal -->
    <div class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="customerModalLabel">Add Customer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="customerForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="customerId" name="Id" value="" />
                    
                    <div class="modal-body p-4">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="FirstName" class="form-control" id="customerFirstName" placeholder="First Name" required />
                                    <label asp-for="FirstName"></label>
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="LastName" class="form-control" id="customerLastName" placeholder="Last Name" required />
                                    <label asp-for="LastName"></label>
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="Email" class="form-control" type="email" id="customerEmail" placeholder="name@example.com" required />
                                    <label asp-for="Email"></label>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input asp-for="Phone" class="form-control" id="customerPhone" placeholder="Phone Number" />
                                    <label asp-for="Phone"></label>
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="Cnic" class="form-control cnic-input" id="customerCnic" placeholder="CNIC No (e.g. 35201-1234567-1)" maxlength="15" />
                            <label for="customerCnic">CNIC No (e.g. 35201-1234567-1)</label>
                            <span asp-validation-for="Cnic" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 py-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark" id="btnSaveCustomer">Save Customer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
