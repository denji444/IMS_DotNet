@{
    Layout = "_Layout";
    ViewData["Title"] = "Supplier Email Verification";
}

<div class="row justify-content-center align-items-center min-vh-75">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-lg mt-5">
            <div class="card-header bg-dark text-white text-center py-4">
                <h3 class="font-weight-light my-1"><i class="fas fa-truck-loading me-2"></i>Supplier Portal</h3>
            </div>
            <div class="card-body p-5 text-center">
                @if (ViewBag.Success == true)
                {
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success fa-4x animate__animated animate__bounceIn"></i>
                    </div>
                    <h4 class="mb-3">Email Verified Successfully!</h4>
                    <p class="text-muted mb-4">
                        Dear supplier, your email address <strong>@ViewBag.Email</strong> has been successfully verified. 
                        You will now receive automatic purchase orders and stock-in transaction updates from our procurement team.
                    </p>
                    <div class="alert alert-success d-inline-block px-4 py-2">
                        <i class="fas fa-info-circle me-2"></i>No further action is required from your side.
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <i class="fas fa-times-circle text-danger fa-4x animate__animated animate__bounceIn"></i>
                    </div>
                    <h4 class="mb-3">Verification Failed</h4>
                    <p class="text-muted mb-4">
                        We were unable to verify your email. The verification link is invalid or may have expired.
                    </p>
                    <p class="text-muted small">
                        Please contact our system administrator to request a new verification link.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
