@{
    Layout = "_Layout";
    ViewData["Title"] = "Master Settings";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-sliders-h me-2 text-primary"></i>Master Settings</h2>
                <p class="text-muted mb-0">Consolidated administration hub for departments, employee directory, attendance, and leaves.</p>
            </div>
        </div>
    </div>
</div>

<!-- Nav Tabs -->
<ul class="nav nav-tabs nav-fill mb-4 bg-white p-2 rounded shadow-sm" id="masterSettingsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="employees-tab" data-bs-toggle="tab" data-bs-target="#employees" type="button" role="tab" aria-controls="employees" aria-selected="true">
            <i class="fas fa-users-cog me-2"></i> Employee Directory
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="departments-tab" data-bs-toggle="tab" data-bs-target="#departments" type="button" role="tab" aria-controls="departments" aria-selected="false">
            <i class="fas fa-sitemap me-2"></i> Departments
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="attendance-tab" data-bs-toggle="tab" data-bs-target="#attendance" type="button" role="tab" aria-controls="attendance" aria-selected="false">
            <i class="fas fa-user-clock me-2"></i> Attendance Log
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="leaves-tab" data-bs-toggle="tab" data-bs-target="#leaves" type="button" role="tab" aria-controls="leaves" aria-selected="false">
            <i class="fas fa-calendar-times me-2"></i> Leave Requests
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button" role="tab" aria-controls="categories" aria-selected="false">
            <i class="fas fa-tags me-2"></i> Product Categories & Types
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="smtp-tab" data-bs-toggle="tab" data-bs-target="#smtp" type="button" role="tab" aria-controls="smtp" aria-selected="false">
            <i class="fas fa-envelope-open-text me-2"></i> SMTP Settings
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="masterSettingsTabsContent">
    
    <!-- Employees Tab -->
    <div class="tab-pane fade show active" id="employees" role="tabpanel" aria-labelledby="employees-tab">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0"><i class="fas fa-users me-2"></i>Manage Employees</h5>
                <button class="btn btn-primary btn-sm" onclick="openEmployeeModal(0)">
                    <i class="fas fa-user-plus me-1"></i> Add Employee
                </button>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100" id="employeesTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Department</th>
                                <th>Designation</th>
                                <th>Hire Date</th>
                                <th>Salary</th>
                                <th>Status</th>
                                <th class="text-center">Profile</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Departments Tab -->
    <div class="tab-pane fade" id="departments" role="tabpanel" aria-labelledby="departments-tab">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0"><i class="fas fa-sitemap me-2"></i>Manage Departments</h5>
                <button class="btn btn-primary btn-sm" onclick="openDeptModal(0)">
                    <i class="fas fa-plus me-1"></i> Add Department
                </button>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100" id="departmentsTable">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Department Name</th>
                                <th>Description</th>
                                <th>Employees Count</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Tab -->
    <div class="tab-pane fade" id="attendance" role="tabpanel" aria-labelledby="attendance-tab">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Manage Attendance</h5>
                <button class="btn btn-primary btn-sm" onclick="openAttendanceModal(0)">
                    <i class="fas fa-calendar-check me-1"></i> Log Attendance
                </button>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100" id="attendanceTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Employee</th>
                                <th>Date</th>
                                <th>Clock In</th>
                                <th>Clock Out</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Leaves Tab -->
    <div class="tab-pane fade" id="leaves" role="tabpanel" aria-labelledby="leaves-tab">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0"><i class="fas fa-calendar-times me-2"></i>Manage Leaves</h5>
                <button class="btn btn-primary btn-sm" onclick="openLeaveModal(0)">
                    <i class="fas fa-file-signature me-1"></i> Add Leave Request
                </button>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100" id="leavesTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Employee</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Leave Type</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories & Types Tab -->
    <div class="tab-pane fade" id="categories" role="tabpanel" aria-labelledby="categories-tab">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0"><i class="fas fa-tags me-2"></i>Manage Product Categories & Dynamic Types</h5>
                <button class="btn btn-primary btn-sm" onclick="openCategoryModal(0)">
                    <i class="fas fa-plus me-1"></i> Add Category
                </button>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-striped w-100" id="categoriesTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>Available Dynamic Types</th>
                                <th class="text-center">Products Count</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- SMTP Settings Tab Pane -->
    <div class="tab-pane fade" id="smtp" role="tabpanel" aria-labelledby="smtp-tab">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0"><i class="fas fa-envelope-open-text me-2"></i>Configure Dynamic SMTP & Email Gateway</h5>
                <span class="badge bg-info text-dark" id="smtpConfigSourceBadge">Checking Source...</span>
            </div>
            <div class="card-body p-4">
                <form id="smtpForm">
                    <input type="hidden" id="smtpId" value="0" />

                    <div class="alert alert-info d-flex align-items-center mb-4 shadow-sm" role="alert">
                        <i class="fas fa-info-circle fa-2x me-3 text-info"></i>
                        <div>
                            <strong>Dynamic Email Gateway:</strong> Configure your SMTP outgoing mail server here. Changes take effect immediately across all email features (Email Confirmation, Sales Invoices, Purchase Orders, and Notifications) without needing app restarts.
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label class="form-label fw-bold"><i class="fas fa-server me-1 text-primary"></i> SMTP Host / Server</label>
                            <input type="text" class="form-control" id="smtpServer" placeholder="e.g. smtp.gmail.com or smtp.office365.com" required />
                            <div class="form-text">Address of your outgoing SMTP mail server provider.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold"><i class="fas fa-plug me-1 text-primary"></i> SMTP Port</label>
                            <input type="number" class="form-control" id="smtpPort" placeholder="e.g. 587 or 465" required min="1" max="65535" />
                            <div class="form-text">Standard ports: 587 (TLS/STARTTLS), 465 (SSL), 25 (Unencrypted).</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold"><i class="fas fa-id-card me-1 text-primary"></i> Sender Display Name</label>
                            <input type="text" class="form-control" id="smtpSenderName" placeholder="e.g. Inventory Management System" required />
                            <div class="form-text">The friendly 'From' name shown in recipient inboxes.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold"><i class="fas fa-at me-1 text-primary"></i> Sender Email Address</label>
                            <input type="email" class="form-control" id="smtpSenderEmail" placeholder="e.g. no-reply@yourcompany.com" required />
                            <div class="form-text">The official email address sending outgoing emails.</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold"><i class="fas fa-user-lock me-1 text-primary"></i> Authentication Username</label>
                            <input type="text" class="form-control" id="smtpUsername" placeholder="e.g. your-email@gmail.com" />
                            <div class="form-text">Leave blank if SMTP server does not require authentication.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold"><i class="fas fa-key me-1 text-primary"></i> Authentication Password / App Key</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="smtpPassword" placeholder="Enter SMTP password or App Password" />
                                <button class="btn btn-outline-secondary" type="button" id="btnToggleSmtpPassword" onclick="togglePasswordVisibility('#smtpPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="form-text">For Gmail, use a 16-character App Password (requires 2FA).</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4 align-items-center">
                        <div class="col-md-6">
                            
                        </div>
                        <div class="col-md-6 text-end">
                            <span class="small text-muted d-block mb-1"><i class="fas fa-history me-1"></i> Last Saved: <strong id="smtpLastUpdated">-</strong></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <button type="button" class="btn btn-outline-primary px-4 py-2 fw-bold" onclick="openTestSmtpModal()">
                            <i class="fas fa-paper-plane me-2"></i> Send Test Email
                        </button>
                        <button type="submit" class="btn btn-success px-5 py-2 fw-bold shadow-sm" id="btnSaveSmtp">
                            <i class="fas fa-save me-2"></i> Save SMTP Configuration
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

<!-- Test SMTP Modal -->
<div class="modal fade" id="testSmtpModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="testSmtpModalLabel">
                    <i class="fas fa-paper-plane me-2"></i>Test SMTP Email Gateway
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="testSmtpForm">
                <div class="modal-body p-4">
                    <p class="text-muted small">Send a test email using the settings currently entered on the SMTP configuration form to verify connection and delivery live.</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Recipient Test Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-envelope text-primary"></i></span>
                            <input type="email" class="form-control" id="testRecipientEmail" placeholder="e.g. admin@example.com" required />
                        </div>
                        <div class="form-text">A test confirmation email will be dispatched to this inbox.</div>
                    </div>
                    <div id="testSmtpResultAlert" class="d-none"></div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary fw-bold" id="btnSendTestEmail">
                        <i class="fas fa-paper-plane me-1"></i> Send Test Email
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Employee Account & User Profile Control Modal -->
<div class="modal fade" id="employeeAccountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white py-3">
                <h5 class="modal-title fw-bold" id="empAccountModalLabel">
                    <i class="fas fa-user-shield me-2 text-info"></i>Employee User Account
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="empAccEmployeeId" value="0" />
                
                <!-- Employee Summary Header -->
                <div class="d-flex align-items-center bg-light p-3 rounded mb-4 border">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px; font-size: 22px;">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark" id="empAccFullName">Employee Name</h5>
                        <p class="text-muted small mb-0"><span id="empAccDesignation">Designation</span> &bull; <span class="badge bg-secondary" id="empAccDepartment">Department</span></p>
                    </div>
                </div>

                <!-- Credentials Info Section -->
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-envelope text-primary"></i></span>
                        <input type="text" class="form-control bg-light" id="empAccEmail" readonly />
                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('#empAccEmail', 'Email copied!')" title="Copy Email">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-user text-primary"></i></span>
                        <input type="text" class="form-control bg-light" id="empAccUsername" readonly />
                        <button class="btn btn-outline-secondary" type="button" onclick="copyToClipboard('#empAccUsername', 'Username copied!')" title="Copy Username">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary small text-uppercase">Password & Credentials Control</label>
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-white"><i class="fas fa-lock text-primary"></i></span>
                        <input type="password" class="form-control bg-light" id="empAccPassword" value="Default@123" readonly />
                        <button class="btn btn-outline-secondary" type="button" id="btnToggleShowPassword" onclick="togglePasswordVisibility()" title="Show/Hide Password">
                            <i class="fas fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted extra-small" style="font-size: 0.8rem;"><i class="fas fa-info-circle me-1"></i>Default Password: <strong>Default@123</strong></span>
                        <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-bold" id="btnResetPassword" onclick="resetEmployeePassword()">
                            <i class="fas fa-key me-1"></i> Reset to Default
                        </button>
                    </div>
                </div>

                <hr class="my-3" />

                <!-- Account Access Status Control -->
                <div class="p-3 rounded border bg-light">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-bold mb-1 text-dark">
                                <i class="fas fa-shield-alt me-1 text-primary"></i> Account Access Status
                            </h6>
                            <p class="text-muted extra-small mb-0" style="font-size: 0.82rem;" id="accountStatusHelpText">
                                Toggle to Restrict or Activate user system access.
                            </p>
                        </div>
                        <div class="form-check form-switch form-switch-md ms-3">
                            <input class="form-check-input" type="checkbox" role="switch" id="empAccRestrictedToggle" style="width: 2.5em; height: 1.25em; cursor: pointer;" onchange="toggleAccountRestriction(this)">
                        </div>
                    </div>
                    <div class="mt-2 text-end">
                        <span class="badge bg-success py-1 px-3" id="empAccStatusBadge">ACCOUNT ACTIVE</span>
                    </div>
                </div>

            </div>
            <div class="modal-footer bg-light border-0 py-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Employee Modal -->
<div class="modal fade" id="employeeModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="employeeModalLabel">Add Employee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="employeeForm">
                <input type="hidden" id="empId" name="Id" value="0" />
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Full Name</label>
                            <input type="text" class="form-control" id="empFullName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email Address</label>
                            <input type="email" class="form-control" id="empEmail" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Phone Number</label>
                            <input type="text" class="form-control" id="empPhone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Department</label>
                            <select class="form-select" id="empDepartmentId">
                                <option value="">Select Department</option>
                                @foreach (var dept in (List<Department>)ViewBag.DepartmentList)
                                {
                                    <option value="@dept.Id">@dept.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Designation</label>
                            <input type="text" class="form-control" id="empDesignation" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Hire Date</label>
                            <input type="date" class="form-control" id="empHireDate" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Salary (Monthly)</label>
                            <input type="number" step="0.01" class="form-control" id="empSalary" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Status</label>
                            <select class="form-select" id="empStatus">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="On Leave">On Leave</option>
                                <option value="Terminated">Terminated</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveEmployee">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Department Modal -->
<div class="modal fade" id="deptModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="deptModalLabel">Add Department</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="deptForm">
                <input type="hidden" id="deptId" name="Id" value="0" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Department Name</label>
                        <input type="text" class="form-control" id="deptName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea class="form-control" id="deptDescription" style="height: 100px;"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveDept">Save Department</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Attendance Modal -->
<div class="modal fade" id="attendanceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="attendanceModalLabel">Log Attendance</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="attendanceForm">
                <input type="hidden" id="attId" name="Id" value="0" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Employee</label>
                        <select class="form-select select2-ajax" id="attEmployeeId" required style="width: 100%;"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Date</label>
                        <input type="date" class="form-control" id="attDate" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Clock In</label>
                            <input type="time" class="form-control" id="attClockIn" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Clock Out</label>
                            <input type="time" class="form-control" id="attClockOut" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <select class="form-select" id="attStatus">
                            <option value="Present">Present</option>
                            <option value="Absent">Absent</option>
                            <option value="Late">Late</option>
                            <option value="Half Day">Half Day</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveAttendance">Save Log</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Leave Modal -->
