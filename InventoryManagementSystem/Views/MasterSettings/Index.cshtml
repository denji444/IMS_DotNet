@{
    Layout = "_Layout";
    ViewData["Title"] = "Master Settings";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div>
                <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-sliders-h me-2 text-primary"></i>Master Settings</h2>
                <p class="text-muted mb-0">Consolidated administration hub for departments, employee directory, attendance, and leaves.</p>
            </div>
        </div>
    </div>
</div>

<!-- Nav Tabs -->
<ul class="nav nav-tabs nav-fill mb-4 bg-white p-2 rounded shadow-sm" id="masterSettingsTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="employees-tab" data-bs-toggle="tab" data-bs-target="#employees" type="button" role="tab" aria-controls="employees" aria-selected="true">
            <i class="fas fa-users-cog me-2"></i> Employee Directory
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="departments-tab" data-bs-toggle="tab" data-bs-target="#departments" type="button" role="tab" aria-controls="departments" aria-selected="false">
            <i class="fas fa-sitemap me-2"></i> Departments
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="attendance-tab" data-bs-toggle="tab" data-bs-target="#attendance" type="button" role="tab" aria-controls="attendance" aria-selected="false">
            <i class="fas fa-user-clock me-2"></i> Attendance Log
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="leaves-tab" data-bs-toggle="tab" data-bs-target="#leaves" type="button" role="tab" aria-controls="leaves" aria-selected="false">
            <i class="fas fa-calendar-times me-2"></i> Leave Requests
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button" role="tab" aria-controls="categories" aria-selected="false">
            <i class="fas fa-tags me-2"></i> Product Categories & Types
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="smtp-tab" data-bs-toggle="tab" data-bs-target="#smtp" type="button" role="tab" aria-controls="smtp" aria-selected="false">
            <i class="fas fa-envelope-open-text me-2"></i> SMTP Settings
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="company-tab" data-bs-toggle="tab" data-bs-target="#company" type="button" role="tab" aria-controls="company" aria-selected="false">
            <i class="fas fa-building me-2"></i> Company Profile
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="masterSettingsTabsContent">
    <partial name="Partials/_EmployeesTab" />
    <partial name="Partials/_DepartmentsTab" />
    <partial name="Partials/_AttendanceTab" />
    <partial name="Partials/_LeavesTab" />
    <partial name="Partials/_CategoriesTab" />
    <partial name="Partials/_SmtpTab" />
    <partial name="Partials/_CompanyProfileTab" />
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/masterSettings.js" asp-append-version="true"></script>
}
