@{
    Layout = "_Layout";
    var currentSection = ViewBag.CurrentSection as string ?? "Staff";
    var activeTab = ViewBag.ActiveTab as string ?? (currentSection == "Staff" ? "employees" : "company");

    if (currentSection == "Staff")
    {
        ViewData["Title"] = "Staff & HR Management";
    }
    else
    {
        ViewData["Title"] = "System Settings & Configuration";
    }
}

@if (currentSection == "Staff")
{
    <!-- Staff & HR Header -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-user-tie me-2 text-primary"></i>Staff & Human Resources</h2>
                    <p class="text-muted mb-0">Manage employee directory, organizational departments, attendance tracking, and leave requests.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Staff & HR Tabs -->
    <ul class="nav nav-tabs nav-fill mb-4 bg-white p-2 rounded shadow-sm" id="masterSettingsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="employees-tab" data-bs-toggle="tab" data-bs-target="#employees" type="button" role="tab" aria-controls="employees">
                <i class="fas fa-users-cog me-2"></i> Employee Directory
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="departments-tab" data-bs-toggle="tab" data-bs-target="#departments" type="button" role="tab" aria-controls="departments">
                <i class="fas fa-sitemap me-2"></i> Departments
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="attendance-tab" data-bs-toggle="tab" data-bs-target="#attendance" type="button" role="tab" aria-controls="attendance">
                <i class="fas fa-user-clock me-2"></i> Attendance Log
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="leaves-tab" data-bs-toggle="tab" data-bs-target="#leaves" type="button" role="tab" aria-controls="leaves">
                <i class="fas fa-calendar-times me-2"></i> Leave Requests
            </button>
        </li>
    </ul>

    <!-- Staff & HR Tab Content -->
    <div class="tab-content" id="masterSettingsTabsContent">
        <partial name="Partials/_EmployeesTab" />
        <partial name="Partials/_DepartmentsTab" />
        <partial name="Partials/_AttendanceTab" />
        <partial name="Partials/_LeavesTab" />
    </div>
}
else
{
    <!-- System Settings Header -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <h2 class="fw-bold mb-0 text-dark"><i class="fas fa-gear me-2 text-primary"></i>System Settings & Configuration</h2>
                    <p class="text-muted mb-0">Configure business branding identity, document print templates, and SMTP email server gateway.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- System Settings Tabs -->
    <ul class="nav nav-tabs nav-fill mb-4 bg-white p-2 rounded shadow-sm" id="masterSettingsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="company-tab" data-bs-toggle="tab" data-bs-target="#company" type="button" role="tab" aria-controls="company">
                <i class="fas fa-building me-2"></i> Company Profile & Branding
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-uppercase py-3 d-flex align-items-center justify-content-center" id="smtp-tab" data-bs-toggle="tab" data-bs-target="#smtp" type="button" role="tab" aria-controls="smtp">
                <i class="fas fa-envelope-open-text me-2"></i> SMTP Email Configuration
            </button>
        </li>
    </ul>

    <!-- System Settings Tab Content -->
    <div class="tab-content" id="masterSettingsTabsContent">
        <partial name="Partials/_CompanyProfileTab" />
        <partial name="Partials/_SmtpTab" />
    </div>
}

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/masterSettings.js" asp-append-version="true"></script>
}
