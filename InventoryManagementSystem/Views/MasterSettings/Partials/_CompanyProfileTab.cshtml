<!-- Company Profile Tab Pane -->
<div class="tab-pane fade" id="company" role="tabpanel" aria-labelledby="company-tab">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="fas fa-building me-2"></i>Manage Dynamic Business & Company Branding Profile</h5>
            <span class="badge bg-info text-dark"><i class="fas fa-print me-1"></i>Applies to all Print Formats & Documents</span>
        </div>
        <div class="card-body p-4">
            <form id="companyProfileForm" enctype="multipart/form-data">
                <input type="hidden" id="companyId" value="0" />

                <div class="alert alert-info d-flex align-items-center mb-4 shadow-sm" role="alert">
                    <i class="fas fa-info-circle fa-2x me-3 text-info"></i>
                    <div>
                        <strong>Dynamic Document Branding:</strong> Configure your business identity details below. The Company Name, Tagline, Address, Contact Info, and uploaded Business Logo will automatically feature across all print receipts, sales invoices, purchase vouchers, and customer statements.
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <!-- Logo Upload Column -->
                    <div class="col-md-4 text-center border-end">
                        <label class="form-label fw-bold d-block mb-3"><i class="fas fa-image me-1 text-primary"></i> Business Logo Emblem</label>
                        
                        <div class="mb-3 d-flex justify-content-center">
                            <div id="companyLogoPreviewContainer" class="p-3 bg-light border rounded shadow-sm d-flex align-items-center justify-content-center" style="width: 180px; height: 180px; position: relative;">
                                <img id="companyLogoPreview" src="" alt="Company Logo" class="img-fluid d-none" style="max-height: 150px; max-width: 150px; object-fit: contain;" />
                                <div id="companyLogoPlaceholder" class="text-center text-muted">
                                    <i class="fas fa-boxes fa-4x text-primary mb-2"></i>
                                    <div class="small fw-bold text-uppercase">IMS Emblem</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="companyLogoFile" class="btn btn-outline-primary btn-sm px-3 fw-bold">
                                <i class="fas fa-upload me-1"></i> Choose New Logo
                            </label>
                            <input type="file" id="companyLogoFile" name="logoFile" class="d-none" accept="image/png, image/jpeg, image/webp, image/svg+xml" onchange="previewCompanyLogo(this)" />
                        </div>
                        <small class="text-muted d-block" style="font-size: 0.8rem;">Supports PNG, JPG, WebP or SVG (Max 5MB)</small>
                    </div>

                    <!-- Company Info Fields Column -->
                    <div class="col-md-8">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold"><i class="fas fa-building me-1 text-primary"></i> Company / Business Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="companyName" placeholder="e.g. IMS Mobile & Electronics Store" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold"><i class="fas fa-quote-left me-1 text-primary"></i> Tagline / Slogan</label>
                                <input type="text" class="form-control" id="companyTagline" placeholder="e.g. Premium Wholesale & Retail Electronics Solutions" />
                                <div class="form-text">Displayed right beneath company header on print receipts.</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold"><i class="fas fa-map-marker-alt me-1 text-primary"></i> Official Address</label>
                            <input type="text" class="form-control" id="companyAddress" placeholder="e.g. Shop #12, Commercial Plaza, Main Market Road, City" />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold"><i class="fas fa-phone me-1 text-primary"></i> Contact Phone Number(s)</label>
                                <input type="text" class="form-control" id="companyPhone" placeholder="e.g. +92 300 1234567, +92 51 9876543" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold"><i class="fas fa-envelope me-1 text-primary"></i> Official Email / Website</label>
                                <input type="text" class="form-control" id="companyEmail" placeholder="e.g. info@imsstore.com | www.imsstore.com" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <span class="small text-muted"><i class="fas fa-history me-1"></i> Last Updated: <strong id="companyLastUpdated">-</strong></span>
                    <button type="submit" class="btn btn-success px-5 py-2 fw-bold shadow-sm" id="btnSaveCompanyProfile">
                        <i class="fas fa-save me-2"></i> Save Company Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
